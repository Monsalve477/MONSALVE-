library(emmeans)
# Crear un dataframe de ejemplo
tu_dataframe <- data.frame(
riego = rep(c("Bajo", "Medio", "Alto"), each = 10),
geno = rep(c("G1", "G2", "G3"), times = 10),
variable_dependiente = c(rnorm(10, mean = 5), rnorm(10, mean = 7), rnorm(10, mean = 9))
)
# Crear un dataframe de ejemplo
tu_dataframe <- data.frame(
riego = rep(c("Bajo", "Medio", "Alto"), each = 10),
geno = rep(c("G1", "G2", "G3"), times = 10),
variable_dependiente = c(rnorm(10, mean = 5), rnorm(10, mean = 7), rnorm(10, mean = 9))
)
# Crear un dataframe de ejemplo
tu_dataframe <- data.frame(
riego = rep(c("Bajo", "Medio", "Alto"), each = 10),
geno = rep(c("G1", "G2", "G3"), times = 10),
variable_dependiente = c(rnorm(10, mean = 5), rnorm(10, mean = 7), rnorm(10, mean = 9))
)
# Crear el modelo ANOVA
modelo <- aov(variable_dependiente ~ riego * geno, data = tu_dataframe)
# Usar emmeans para obtener las estimaciones marginales
resultados_emmeans <- emmeans(modelo, ~ riego * geno)
# Imprimir resultados
print(resultados_emmeans)
tu_dataframe <- emmeans(modelo, ~riego*geno)
tu_dataframe <- emmeans(modelo, ~riego|geno)
tu_dataframe <- emmeans(modelo, ~riego|geno) %>%
as.data.frame()
tu_dataframe
