# Cargar la librería ggplot2
library(ggplot2)
# Crear un dataframe de ejemplo
tu_dataframe <- data.frame(
variedad = rep(c("Variedad1", "Variedad2", "Variedad3"), each = 10),
valor = c(rnorm(10, mean = 5), rnorm(10, mean = 7), rnorm(10, mean = 9))
)
# Crear el gráfico de barras
ggplot(tu_dataframe, aes(x = variedad, y = valor, fill = variedad)) +
geom_bar(stat = "identity", position = position_dodge()) +
labs(x = "Variedad", y = "Valor") +
theme_minimal()
ggplot(tu_dataframe, aes(x = variedad, y = lfa, fill = riego)) +
geom_bar(stat = "identity", position = position_dodge()) +
geom_text(aes(label = groups), position = position_dodge(0.9), vjust = -0.5) +
labs(x = "Variedad", y = "LFA", fill = "Riego") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
